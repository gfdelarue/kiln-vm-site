---
import "../styles/plates.css";
import Reliefs from "../components/Reliefs.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TopBar from "../components/TopBar.astro";
import Base from "./Base.astro";

interface Props {
  path: string;
  title: string;
  description: string;
}

const { path, title, description } = Astro.props;
const grounded = Astro.slots.has("ground");
---

<Base title={title} description={description}>
  <Reliefs />
  <header class:list={["panel", !grounded && "panel--fill"]}>
    <TopBar path={path} />
    <slot name="open" />
  </header>
  {
    grounded && (
      <main>
        <slot />
        <div class="ground">
          <slot name="ground" />
        </div>
      </main>
    )
  }
  <SiteFooter path={path} joined={grounded} />
</Base>

<style>
  main {
    display: flex;
    flex: none;
    flex-direction: column;
  }
</style>

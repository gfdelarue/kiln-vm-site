---
import Cmd from "./Cmd.astro";

interface Step {
  command: string;
  text: string;
}

interface Props {
  items: Step[];
  ordered?: boolean;
  layout?: "column" | "stems";
}

const { items, ordered = false, layout = "column" } = Astro.props;
const List = ordered ? "ol" : "ul";
---

<List class:list={["steps", `steps--${layout}`]}>
  {
    items.map((item) => (
      <li>
        <Cmd line={item.command} />
        <p set:html={item.text} />
      </li>
    ))
  }
</List>

<style>
  .steps {
    display: grid;
    align-content: start;
    gap: clamp(1.5rem, 2.4vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps--stems {
    grid-template-columns: minmax(0, 45.4fr) minmax(0, 27.3fr) minmax(0, 27.3fr);
    row-gap: clamp(2rem, 3.4vw, 3.25rem);
    column-gap: 0;
  }

  .steps--stems li:nth-child(3n + 1) {
    padding-right: var(--between);
  }

  .steps--stems li:nth-child(3n + 2) {
    padding-right: calc(var(--between) / 2);
  }

  .steps--stems li:nth-child(3n) {
    padding-left: calc(var(--between) / 2);
  }

  p {
    max-width: 26em;
    margin: 0.7rem 0 0;
  }

  @media (max-width: 60em) {
    .steps--stems {
      grid-template-columns: minmax(0, 1fr);
    }

    .steps--stems li:nth-child(n) {
      padding-inline: 0;
    }
  }
</style>

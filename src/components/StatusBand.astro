---
import { url } from "../site";

interface Props {
  linkToHost?: boolean;
}

const { linkToHost = false } = Astro.props;
---

<section class="slab status" aria-labelledby="s-status">
  <h2 class="say say--slab" id="s-status">Kiln is not released yet.</h2>
  <div class="zones">
    <div class="zones__k">
      <p class="lead lead--pitch">It is in private development, and there is nothing to download today.</p>
    </div>
    <div class="zones__iln">
      {
        linkToHost && (
          <p class="lead">
            The <a href={url("/host/")}>host page</a> lists what Kiln needs to run and the checks it makes first.
          </p>
        )
      }
      <p class="lead">
        Kiln Console, the iOS companion app, is at its first milestone. It is a read-only dashboard running on sample
        data.
      </p>
    </div>
  </div>
</section>

<style>
  .zones__iln p {
    max-width: 30em;
  }
</style>

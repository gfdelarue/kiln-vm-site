---
import { pages, url } from "../site";
---

<footer class="slab">
  <div class="slab__in">
    <nav aria-label="Main">
      <ul>
        {
          pages.map((page) => (
            <li>
              <a href={url(page.path)}>
                <span class="slab__name">{page.name}</span>
                <span class="slab__line">{page.line}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="slab__in slab__ghost" aria-hidden="true">
    <div>
      <ul>
        {
          pages.map((page) => (
            <li>
              <span class="slab__name">{page.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<script>
  const slab = document.querySelector<HTMLElement>(".slab");
  const ghost = slab?.querySelector<HTMLElement>(".slab__ghost");
  const names = [...(ghost?.querySelectorAll<HTMLElement>(".slab__name") ?? [])];
  const links = [...(slab?.querySelectorAll<HTMLAnchorElement>("a") ?? [])];

  if (slab && ghost && names.length) {
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    const easing = "cubic-bezier(0.65, 0, 0.35, 1)";
    const leadIn = 800;
    let motion: Animation | undefined;
    let rests: number[] = [];
    let inside = false;

    const frame = (index: number, part: "whole" | "lead" | "tail" | "enter" | "exit") => {
      const outer = ghost.getBoundingClientRect();
      const box = names[index].getBoundingClientRect();
      const em = parseFloat(getComputedStyle(names[index]).fontSize);
      const bar = 0.18 * em;
      const top = box.top - outer.top - 0.3 * em;
      const bottom = outer.bottom - box.bottom - 0.36 * em;
      let left = box.left - outer.left - 0.4 * em;
      let right = outer.right - box.right - 0.4 * em;

      if (part === "lead") right = outer.width - left - bar;
      if (part === "tail") left = outer.width - right - bar;
      if (part === "enter") [left, right] = [0, outer.width];
      if (part === "exit") [left, right] = [outer.width, 0];

      return `inset(${top}px ${right}px ${bottom}px ${left}px)`;
    };

    const sameRow = (a: number, b: number) =>
      Math.abs(names[a].getBoundingClientRect().top - names[b].getBoundingClientRect().top) < 1;

    const cycle = () => {
      const steps: { clipPath: string; time: number }[] = [];
      let time = 0;
      const step = (clipPath: string, duration: number) => steps.push({ clipPath, time: (time += duration) });

      rests = [];
      step(frame(0, "enter"), 0);

      names.forEach((_, index) => {
        step(frame(index, "lead"), index === 0 ? 700 : sameRow(index - 1, index) ? 900 : 0);
        step(frame(index, "whole"), 1000);
        rests.push(time);
        step(frame(index, "whole"), 3000);
        step(frame(index, "tail"), 800);
      });

      step(frame(names.length - 1, "exit"), 700);

      return {
        duration: time,
        keyframes: steps.map((each) => ({ clipPath: each.clipPath, offset: each.time / time, easing })),
      };
    };

    const sync = (link = -1) => {
      if (!motion) return;

      const held = inside || slab.querySelector("a:focus-visible") !== null;

      if (link >= 0) motion.currentTime = leadIn + rests[link];
      if (still.matches && !held) motion.currentTime = 0;
      if (held || still.matches) motion.pause();
      else motion.play();
    };

    const build = () => {
      const time = motion?.currentTime ?? 0;

      motion?.cancel();
      motion = undefined;
      if (!ghost.offsetWidth) return;

      const { keyframes, duration } = cycle();

      motion = ghost.animate(keyframes, { duration, delay: leadIn, iterations: Infinity });
      motion.currentTime = time;
      sync();
    };

    slab.addEventListener("pointerover", (event) => {
      if (event.pointerType === "touch") return;
      inside = true;
      sync(links.findIndex((link) => link.contains(event.target as Node)));
    });

    slab.addEventListener("pointerleave", () => {
      inside = false;
      sync();
    });

    slab.addEventListener("focusin", (event) => {
      sync(links.findIndex((link) => link === event.target && link.matches(":focus-visible")));
    });

    slab.addEventListener("focusout", () => sync());
    still.addEventListener("change", () => sync());

    document.fonts.ready.then(() => new ResizeObserver(build).observe(ghost));
  }
</script>

<style>
  .slab {
    container-type: size;
    flex: 1 0 0;
    min-height: 6.5rem;
    position: relative;
    border-top: 1px solid rgb(10 24 56 / 0.25);
    background: var(--rib), var(--orange-deep);
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 85%;
    font-variation-settings: "wdth" 85;
  }

  .slab__in {
    display: flex;
    height: 100%;
    padding: 1.5rem var(--gutter) 2rem;
  }

  .slab__in > * {
    flex: 1;
  }

  .slab__ghost {
    position: absolute;
    inset: 0;
    background: var(--pinstripe), var(--surface);
    clip-path: inset(0 100% 0 0);
    pointer-events: none;
  }

  .slab__ghost .slab__name {
    color: var(--orange-deep);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem clamp(1rem, 2.4vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
  }

  a:focus-visible {
    outline-color: var(--ink);
  }

  .slab__name {
    position: relative;
    z-index: 0;
    display: inline-block;
    color: var(--paper);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.1vw, 2.5rem);
    font-weight: 400;
    font-stretch: 100%;
    font-variation-settings: normal;
    letter-spacing: -0.04em;
    line-height: 1.15;
    -webkit-text-stroke: 0.02em currentColor;
  }

  @container (height < 19rem) {
    a:hover .slab__name,
    a:focus-visible .slab__name {
      color: var(--orange-deep);
    }

    a:hover .slab__name::before,
    a:focus-visible .slab__name::before {
      content: "";
      position: absolute;
      inset: -0.3em -0.4em -0.36em;
      z-index: -1;
      background: var(--pinstripe), var(--surface);
    }
  }

  .slab__line {
    display: none;
  }

  @container (min-height: 19rem) {
    .slab__ghost {
      display: none;
    }

    a:hover .slab__name {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.22em;
    }

    .slab__in {
      display: block;
      padding-block: clamp(1.25rem, 5cqh, 2.5rem) clamp(1.25rem, 5cqh, 2rem);
    }

    ul {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
      align-content: start;
      gap: 0 2.5rem;
    }

    li {
      border-bottom: 1px solid rgb(10 24 56 / 0.28);
    }

    a {
      display: block;
      padding-block: clamp(0.6rem, 2.6cqh, 1.1rem);
    }

    .slab__name {
      display: block;
      font-size: clamp(1.5rem, 5.4cqh, 1.875rem);
    }

    .slab__line {
      display: block;
      max-width: 30em;
      margin-top: 0.3rem;
      font-weight: 500;
      line-height: 1.35;
    }
  }

  @container (min-height: 19rem) and (max-height: 27rem) {
    .slab__line {
      display: none;
    }
  }
</style>

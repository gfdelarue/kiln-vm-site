---
import SiteNav from "./SiteNav.astro";

interface Props {
  path: string;
  title: string;
  lead: string;
}

const { path, title, lead } = Astro.props;
---

<header class="head">
  <SiteNav path={path} />
  <h1>{title}</h1>
  <div class="zones">
    <div class="zones__k">
      <p class="lead lead--pitch">{lead}</p>
    </div>
    <div class="zones__iln">
      <slot name="aside" />
    </div>
  </div>
  <slot />
</header>

<style>
  .head {
    padding: clamp(1.1rem, 2.4vw, 2.1rem) var(--gutter) var(--band);
    background: var(--rib), linear-gradient(180deg, var(--orange), var(--orange-deep));
    font-size: var(--text);
  }

  h1 {
    max-width: 17em;
    margin: clamp(3.5rem, 8vw, 8.5rem) 0 clamp(2rem, 4vw, 4rem);
    color: #ffffff;
    font-size: clamp(1.75rem, 4.7vw, 6.5rem);
    line-height: 1.05;
  }

  .zones {
    align-items: start;
  }
</style>

---
interface Term {
  term: string;
  text: string;
  plain?: boolean;
}

interface Props {
  items: Term[];
  columns?: 1 | 2;
  layout?: "stacked" | "beside";
  tone?: "panel" | "slab";
}

const { items, columns = 1, layout = "stacked", tone = "panel" } = Astro.props;
---

<dl class:list={["terms", `terms--${layout}`, `terms--${tone}`, columns === 2 && "terms--two"]}>
  {
    items.map((item) => (
      <div>
        <dt>{item.plain ? item.term : <code>{item.term}</code>}</dt>
        <dd set:html={item.text} />
      </div>
    ))
  }
</dl>

<style>
  .terms {
    display: grid;
    align-content: start;
    gap: clamp(1.5rem, 2.6vw, 2.5rem) var(--between);
    margin: 0;
  }

  .terms--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .terms--beside {
    gap: 1.25rem;
  }

  .terms--beside div {
    display: grid;
    grid-template-columns: var(--term, 7.5em) minmax(0, 1fr);
    gap: 0 1rem;
    align-items: baseline;
  }

  dt {
    font-size: 1.1em;
    font-weight: 600;
    font-stretch: 92%;
    font-variation-settings: "wdth" 92;
    line-height: 1.3;
  }

  dt code {
    font-size: 0.92em;
    font-weight: 600;
  }

  .terms--slab dt {
    color: #ffffff;
    font-size: 1.25em;
  }

  dd {
    max-width: 30em;
    margin: 0.25rem 0 0;
  }

  .terms--slab dd {
    font-weight: 500;
  }

  .terms--beside dd {
    margin: 0;
  }

  @media (max-width: 34em) {
    .terms--two,
    .terms--beside div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

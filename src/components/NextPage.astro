---
import { pages, url } from "../site";

interface Props {
  path: string;
}

const { path } = Astro.props;
const index = pages.findIndex((page) => page.path === path);
const next = index === -1 ? undefined : pages[index + 1];
const show = next !== undefined;
---

{
  show && (
    <nav class="slab next" aria-label="Next page">
      <p class="next__label">Next</p>
      <a href={url(next.path)}>{next.name}</a>
      <p class="next__line">{next.line}</p>
    </nav>
  )
}

<style>
  .next {
    font-size: var(--text);
  }

  .next__label {
    margin: 0 0 0.5rem;
    font-weight: 600;
    font-stretch: 85%;
    font-variation-settings: "wdth" 85;
  }

  a {
    display: inline-block;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 7.4vw, 9rem);
    letter-spacing: -0.045em;
    line-height: 1;
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.14em;
  }

  .next__line {
    max-width: 28em;
    margin: clamp(1.25rem, 2.4vw, 2.25rem) 0 0;
    font-size: 1.2em;
    font-weight: 500;
    line-height: 1.42;
  }
</style>

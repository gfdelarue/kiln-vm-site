---
interface Row {
  name: string;
  text: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<dl class="plate">
  {
    rows.map((row) => (
      <div>
        <dt>{row.name}</dt>
        <dd>{row.text}</dd>
      </div>
    ))
  }
</dl>

<style>
  .plate {
    display: grid;
    gap: 1.1em;
    margin: 0;
    padding: clamp(1.75rem, 3vw, 3rem);
    border-radius: 14px;
    outline: 1.5px solid var(--ink);
    outline-offset: -9px;
    background: #ffffff;
    box-shadow: 0 3px 0 rgb(10 24 56 / 0.18);
    line-height: 1.35;
  }

  div {
    display: grid;
    grid-template-columns: 8.5em minmax(0, 1fr);
    gap: 0 1rem;
  }

  dt {
    font-weight: 700;
    font-stretch: 80%;
    font-variation-settings: "wdth" 80;
  }

  dd {
    margin: 0;
    font-weight: 500;
  }

  @media (max-width: 34em) {
    div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

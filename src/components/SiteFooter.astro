---
import { pages, product, status, url } from "../site";

interface Props {
  path: string;
}

const { path } = Astro.props;
const index = pages.findIndex((page) => page.path === path);
const next = index === -1 ? undefined : pages[index + 1];
const last = index === pages.length - 1;
---

<footer class="foot">
  <div class="foot__in">
    {
      next && (
        <a class="next" href={url(next.path)}>
          <span class="next__label">Next</span>
          <span class="next__name">{next.name}</span>
          <span class="next__line">{next.line}</span>
        </a>
      )
    }
    {
      last && (
        <div class="next next--status">
          <span class="next__name">{status}</span>
          <span class="next__line">{product} is free and will be open source. There is nothing to install today.</span>
        </div>
      )
    }
    <div class="foot__row">
      <p>
        <a href={url("/")}>{product}</a>
        {!last && <span>{status}</span>}
      </p>
      <ul>
        {
          pages.map((page) => (
            <li>
              <a href={url(page.path)}>{page.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .foot {
    flex: none;
    border-top: 1px solid rgb(10 24 56 / 0.25);
    background: var(--rib), linear-gradient(180deg, var(--orange-at-crop), var(--orange-deep));
  }

  .foot__in {
    padding-inline: var(--gutter);
  }

  .next {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: end;
    gap: 0.75rem clamp(2rem, 5vw, 5rem);
    padding-block: clamp(2rem, 5vw, 4.5rem);
    border-bottom: 1px solid rgb(10 24 56 / 0.28);
    text-decoration: none;
  }

  .next__label {
    grid-column: 1 / -1;
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 85%;
    font-variation-settings: "wdth" 85;
  }

  .next__name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1rem + 6vw, 6rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }

  a.next:hover .next__name {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.14em;
  }

  .next--status {
    grid-template-columns: minmax(0, 1fr);
  }

  .next__line {
    max-width: 26em;
    padding-bottom: 0.35em;
    font-size: var(--lead);
    font-weight: 500;
    line-height: 1.4;
  }

  .foot__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.5rem 2rem;
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 85%;
    font-variation-settings: "wdth" 85;
  }

  p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
  }

  p span {
    font-weight: 500;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem clamp(1rem, 2.4vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot__row a {
    text-decoration: none;
  }

  .foot__row a:hover {
    text-decoration: underline;
  }

  a:focus-visible {
    outline-color: var(--ink);
  }

  @media (max-width: 56em) {
    .next {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import { pages, url } from "../site";

interface Props {
  path: string;
}

const { path } = Astro.props;
---

<footer class="foot">
  <p>{path === "/" ? "Kiln" : <a href={url("/")}>Kiln</a>}, a local cloud for Linux hosts with KVM.</p>
  <ul>
    {
      pages.map((page) => (
        <li>
          <a href={url(page.path)}>{page.name}</a>
        </li>
      ))
    }
  </ul>
</footer>

<style>
  .foot {
    display: flex;
    flex: 1 0 auto;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 1.5rem var(--gutter) 2rem;
    border-top: 1px solid rgb(10 24 56 / 0.25);
    background: var(--rib), var(--orange-deep);
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 85%;
    font-variation-settings: "wdth" 85;
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem clamp(1rem, 2.4vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }
</style>

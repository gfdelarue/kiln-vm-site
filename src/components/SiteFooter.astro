---
import { pages, product, status, url } from "../site";

interface Props {
  path: string;
  joined?: boolean;
}

const { path, joined = false } = Astro.props;
const index = pages.findIndex((page) => page.path === path);
const next = index === -1 ? undefined : pages[index + 1];
const last = index === pages.length - 1;
---

<footer class:list={["foot", joined && "foot--joined"]}>
  {
    next && (
      <a class="next" href={url(next.path)}>
        <span class="next__label">Next</span>
        <span class="next__name">{next.name}</span>
        <span class="next__line">{next.line}</span>
      </a>
    )
  }
  <div class="foot__row">
    <p>
      <a href={url("/")}>{product}</a>
      {!last && <span>{status}</span>}
    </p>
    <ul>
      {
        pages.map((page) => (
          <li>
            <a href={url(page.path)}>{page.name}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .foot {
    flex: none;
    padding-inline: var(--gutter);
    border-top: 1px solid rgb(10 24 56 / 0.25);
    background: var(--rib), var(--orange-deep);
  }

  .foot--joined {
    border-top: 0;
  }

  .next {
    display: grid;
    grid-template-columns: 34.37% 1fr 34.37%;
    align-items: baseline;
    row-gap: 0.35rem;
    padding-block: 0.5rem 1.9rem;
    text-decoration: none;
  }

  .next__label {
    grid-column: 1 / -1;
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 85%;
    font-variation-settings: "wdth" 85;
  }

  .next__name {
    grid-column: 1 / 3;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .next:hover .next__name {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.14em;
  }

  .next__line {
    max-width: 27rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .foot__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.25rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 85%;
    font-variation-settings: "wdth" 85;
  }

  .foot--joined .foot__row {
    border-top: 1px solid rgb(10 24 56 / 0.28);
  }

  p {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
  }

  p span {
    font-weight: 500;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem clamp(1rem, 2.4vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .foot__row a {
    text-decoration: none;
  }

  .foot__row a:hover {
    text-decoration: underline;
  }

  a:focus-visible {
    outline-color: var(--ink);
  }

  @media (min-width: 104em) {
    .next__line {
      font-size: clamp(1rem, 0.5rem + 0.55vw, 1.375rem);
    }
  }

  @media (max-width: 1080px) {
    .next {
      grid-template-columns: minmax(0, 1fr);
    }

    .next__name {
      grid-column: auto;
    }
  }
</style>

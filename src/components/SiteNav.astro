---
import { pages, status, url } from "../site";

interface Props {
  path: string;
}

const { path } = Astro.props;
const home = path === "/";
---

<nav class:list={["nav", home && "nav--home"]} aria-label="Main">
  {!home && <a class="nav__home" href={url("/")}>Kiln</a>}
  <ul>
    {
      pages.map((page) => (
        <li>
          <a href={url(page.path)} aria-current={page.path === path ? "page" : undefined}>
            {page.name}
          </a>
        </li>
      ))
    }
  </ul>
  {home && <p>{status}</p>}
</nav>

<style>
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 2rem;
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 85%;
    font-variation-settings: "wdth" 85;
    letter-spacing: 0.005em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem clamp(1rem, 2.4vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    text-decoration: none;
  }

  a:hover,
  a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .nav__home {
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    font-stretch: 100%;
    font-variation-settings: normal;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  p {
    margin: 0;
    opacity: 0.78;
  }

  @media (max-width: 34em) {
    .nav {
      font-size: 0.8125rem;
    }

    ul {
      flex: 1 0 100%;
      justify-content: space-between;
      column-gap: 0.5rem;
    }
  }
</style>

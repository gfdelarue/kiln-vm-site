---
const events = [
  { at: 0, label: "kilnd starts" },
  { at: 22, label: "idle timeout" },
  { at: 40, label: "request" },
  { at: 66, label: "idle timeout" },
  { at: 82, label: "request" },
];

const modes = [
  { mode: "always", text: "Starts with the daemon and never idle-stops.", runs: [[0, 100]] },
  {
    mode: "warm",
    text: "Starts with the daemon, idle-stops, wakes on use.",
    runs: [
      [0, 22],
      [40, 66],
      [82, 100],
    ],
  },
  {
    mode: "on_demand",
    text: "Starts on first use and idle-stops after the timeout.",
    runs: [
      [40, 66],
      [82, 100],
    ],
  },
];
---

<figure class="power">
  <div class="power__events" aria-hidden="true">
    {events.map((event) => <span style={`--at: ${event.at}%`}>{event.label}</span>)}
  </div>
  <ul class="power__rows">
    {
      modes.map((row) => (
        <li>
          <p>
            <code>{row.mode}</code> {row.text}
          </p>
          <div class="track" aria-hidden="true">
            {row.runs.map(([a, b]) => (
              <i style={`--a: ${a}%; --b: ${b}%`} />
            ))}
          </div>
        </li>
      ))
    }
    <li>
      <p><code>manual</code> Changes only when you run start or stop.</p>
      <div class="track" aria-hidden="true">
        <i class="track__named" style="--a: 30%; --b: 74%"><b>vm start</b><b>vm stop</b></i>
      </div>
    </li>
  </ul>
  <figcaption>
    Orange is a running machine. Each row shows the same daemon start, two requests and two idle timeouts.
  </figcaption>
</figure>

<style>
  .power {
    margin: 0;
  }

  .power__events {
    position: relative;
    height: 2.5rem;
    margin-left: 45.4%;
    font-size: 0.8125rem;
    font-weight: 600;
    font-stretch: 82%;
    font-variation-settings: "wdth" 82;
    line-height: 1;
  }

  .power__events span {
    position: absolute;
    bottom: 0;
    left: var(--at);
    padding: 0 0 1.1rem 0.4rem;
    border-left: 1px solid rgb(10 24 56 / 0.45);
    white-space: nowrap;
  }

  .power__rows {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: minmax(0, var(--stem-k)) minmax(0, var(--stem-iln));
    align-items: center;
  }

  p {
    display: flex;
    align-items: baseline;
    gap: 0 1rem;
    margin: 0;
    padding-right: 2rem;
    font-size: 0.92em;
    line-height: 1.3;
  }

  p code {
    flex: none;
    width: 7.2em;
    font-size: 0.95em;
    font-weight: 600;
  }

  .track {
    position: relative;
    height: clamp(2.5rem, 3.6vw, 3.75rem);
    overflow: hidden;
    border-radius: 4px;
    background:
      linear-gradient(rgb(10 24 56 / 0.28) 0 0) 22% 0 / 1px 100% no-repeat,
      linear-gradient(rgb(10 24 56 / 0.28) 0 0) 40% 0 / 1px 100% no-repeat,
      linear-gradient(rgb(10 24 56 / 0.28) 0 0) 66% 0 / 1px 100% no-repeat,
      linear-gradient(rgb(10 24 56 / 0.28) 0 0) 82% 0 / 1px 100% no-repeat,
      rgb(10 24 56 / 0.07);
    box-shadow: inset 0 1px 2px rgb(10 24 56 / 0.22);
  }

  .track i {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--a);
    width: calc(var(--b) - var(--a));
    background: var(--rib), var(--moulded);
  }

  .track__named {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-style: normal;
    font-stretch: 80%;
    font-variation-settings: "wdth" 80;
    white-space: nowrap;
  }

  .track__named b {
    font-weight: 600;
  }

  figcaption {
    max-width: 34em;
    margin: 1.25rem 0 0 45.4%;
    font-size: 0.9em;
  }

  @media (max-width: 60em) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }

    .power__events {
      height: 3.6rem;
      margin-left: 0;
    }

    .power__events span:nth-child(even) {
      padding-bottom: 2.2rem;
    }

    .power__rows {
      gap: 1.5rem;
    }

    p {
      order: 1;
      margin-top: 0.55rem;
      padding-right: 0;
    }

    figcaption {
      margin-left: 0;
    }
  }

  @media (max-width: 34em) {
    p {
      flex-wrap: wrap;
    }

    p code {
      width: 100%;
    }
  }
</style>

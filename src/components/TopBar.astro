---
import { pages, product, url } from "../site";

interface Props {
  path: string;
}

const { path } = Astro.props;
---

<div class="top">
  <a class="top__mark" href={url("/")}>{product}</a>
  <nav aria-label="Main">
    <ul>
      {
        pages.map((page) => (
          <li>
            <a href={url(page.path)} aria-current={page.path === path ? "page" : undefined}>
              {page.name}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .top__mark {
    background-image: var(--rib), var(--moulded);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-family: var(--font-display);
    font-size: 1.3125rem;
    letter-spacing: -0.04em;
    line-height: 1.2;
    text-decoration: none;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem clamp(1rem, 2.4vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 85%;
    font-variation-settings: "wdth" 85;
  }

  li a {
    display: block;
    padding-block: 0.25rem;
    border-bottom: 3px solid transparent;
    text-decoration: none;
  }

  li a:hover {
    border-bottom-color: rgb(10 24 56 / 0.25);
  }

  li a[aria-current="page"] {
    border-bottom-color: var(--orange);
  }

  @media (max-width: 30em) {
    nav {
      flex: 1 0 100%;
    }

    ul {
      justify-content: space-between;
      column-gap: 0.5rem;
    }
  }
</style>

---
import Page from "../layouts/Page.astro";

const profiles = [
  { name: "alpine", size: "1 vCPU, 512 MB memory, 1 GB disk", note: "What you get without --profile" },
  { name: "debian", size: "2 vCPUs, 2 GB memory, 8 GB disk" },
  { name: "ubuntu", size: "2 vCPUs, 2 GB memory, 8 GB disk" },
  { name: "kali", size: "2 vCPUs, 4 GB memory, 32 GB disk" },
  { name: "ubuntu-docker", size: "4 vCPUs, 8 GB memory, 64 GB disk", note: "Docker is set up in the image" },
  { name: "windows11", size: "2 vCPUs, 4 GB memory, 64 GB disk", note: "Prepared from your own install media" },
];
---

<Page
  path="/machines/"
  title="Machines | kiln-vm"
  description="kiln-vm creates named VMs from profiles. Each VM keeps its disk across stops, starts and daemon restarts."
>
  <Fragment slot="open">
    <div class="say">
      <div class="say__lead">
        <h1 class="say__title">Machines</h1>
        <pre class="cmd">kiln-vm create dev --profile ubuntu
kiln-vm exec dev -- uname -a
kiln-vm shell dev</pre>
      </div>
      <p class="say__text">
        Every VM has a name, a profile and a disk of its own. Create one and it boots in the background. From then on
        you run commands in it by name.
      </p>
    </div>
    <p class="form form--lit dev" aria-hidden="true">dev</p>
  </Fragment>

  <section class="plate plate--panel">
    <div class="say">
      <div class="say__lead">
        <h2 class="say__title">Stopped</h2>
        <pre class="cmd">kiln-vm stop dev
kiln-vm start dev</pre>
      </div>
      <p class="say__text">
        Stopping a VM frees its CPU and memory. The disk, the name and the address stay, and the next start boots from
        the same disk.
      </p>
    </div>
    <p class="form form--cold dev" aria-hidden="true">dev</p>
  </section>

  <section class="plate plate--panel gone">
    <div class="say">
      <div class="say__lead">
        <h2 class="say__title">Deleted</h2>
        <pre class="cmd">kiln-vm delete dev</pre>
      </div>
      <p class="say__text">
        Deleting removes the VM and its disk. The guest gets no shutdown first, so stop it yourself if that matters.
      </p>
    </div>
  </section>

  <section class="plate plate--slab plate--end">
    <div class="say">
      <div class="say__lead">
        <h2 class="say__title">Profiles</h2>
      </div>
      <p class="say__text">
        A profile sets the guest image and a default size. <code>--vcpus</code>, <code>--memory-mb</code> and
        <code>--disk</code> change the size for one VM.
      </p>
    </div>
    <ul class="profiles">
      {
        profiles.map((profile) => (
          <li>
            <span class="profiles__name">{profile.name}</span>
            <span>{profile.size}</span>
            {profile.note && <span class="profiles__note">{profile.note}</span>}
          </li>
        ))
      }
    </ul>
  </section>
</Page>

<style>
  .dev {
    --fit: 2.168;
    --bearing: 0.047em;
  }

  .gone {
    min-height: clamp(15rem, 30vw, 32rem);
  }

  .profiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 3.5vw, 3.5rem) 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 600;
    font-stretch: 85%;
    font-variation-settings: "wdth" 85;
    line-height: 1.4;
  }

  .profiles span {
    display: block;
  }

  .profiles__name {
    margin-bottom: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1rem + 1.5vw, 2.25rem);
    font-weight: 400;
    font-stretch: 100%;
    font-variation-settings: normal;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .profiles__note {
    font-weight: 500;
  }

  @media (max-width: 62em) {
    .profiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 34em) {
    .profiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

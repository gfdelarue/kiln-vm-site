---
import Page from "../layouts/Page.astro";
---

<Page path="/404/" title="Page not found | kiln-vm" description="This address does not match a page on the kiln-vm site.">
  <Fragment slot="open">
    <div class="say">
      <div class="say__lead">
        <h1 class="say__title">Nothing here</h1>
      </div>
      <p class="say__text">No page lives at this address. The menu above has every page on the site.</p>
    </div>
    <p class="form form--cold missing" aria-hidden="true">404</p>
  </Fragment>
</Page>

<style>
  .missing {
    --fit: 2.726;
    --bearing: 0.063em;
  }
</style>

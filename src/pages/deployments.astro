---
import Block from "../components/Block.astro";
import Cmd from "../components/Cmd.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import Terms from "../components/Terms.astro";
import Base from "../layouts/Base.astro";

const path = "/deployments/";

const policies = [
  {
    term: "safe",
    text: "The default. Kiln replaces a VM only in phases where it can roll the replacement back, and refuses anywhere else.",
  },
  {
    term: "reject",
    text: "Kiln never replaces the VM. It reports what differs and leaves the VM as it is.",
  },
  {
    term: "replace",
    text: "You ask for a replacement. Kiln still checks that the deployment owns the VM and that it can roll back.",
  },
];

const outputs = [
  { term: "deployment", text: "Its id, name, generation, state and readiness." },
  { term: "services", text: "The URLs, access kind and readiness of each service." },
  { term: "resources", text: "Connection fields for each appliance the deployment uses." },
  { term: "redaction", text: "Whether the response is redacted or raw, and which fields count as secret." },
];

const workflow = `- uses: kiln-deploy/action@v1
  with:
    api-url: \${{ secrets.KILN_API_URL }}
    token: \${{ secrets.KILN_TOKEN }}
    name: demo
    dockerfile: ./Dockerfile
    context-dir: .`;
---

<Base
  title="Deployments | Kiln"
  description="A Kiln deployment declares the machines, networks and services that should exist. Kiln plans the difference and reports what it could not do."
  path={path}
>
  <PageHeader
    slot="header"
    path={path}
    title="Declare it. Kiln reconciles it."
    lead="A deployment declares the resources that should exist. Kiln compares that with what it recorded as the deployment's own and with what is running, then plans the difference."
  >
    <Cmd slot="aside" line="kiln deployment outputs app --generation 4" />
  </PageHeader>

  <Section id="s-shape" title="A shape change never replaces a VM by surprise.">
    <div class="zones">
      <div class="zones__k">
        <p class="lead">
          Profile, CPU, memory and disk size are fixed once a VM exists. Changing any of them means a new VM, so each
          deployment machine sets a <code>shape_change_policy</code> that says what Kiln may do.
        </p>
        <p>
          Power mode and private-network attachment are different. Kiln changes those in place and keeps the VM.
        </p>
        <h3 class="sub recovery">Kiln says what to do next.</h3>
        <p>
          When Kiln refuses an operation, the deployment's <code>Recovery</code> and <code>Conditions</code> fields
          say whether to recover, reapply, delete or retry.
        </p>
      </div>
      <div class="zones__iln">
        <Terms items={policies} layout="beside" />
      </div>
    </div>
  </Section>

  <Section tone="slab" id="s-outputs" title="Outputs belong to one generation.">
    <div class="zones">
      <div class="zones__k">
        <p class="lead lead--pitch">
          Clients read service URLs and connection details from the outputs, and never rebuild them from raw resources.
          Ask for a generation that is no longer current and Kiln answers with a conflict.
        </p>
        <div class="stack-cmds">
          <Cmd line="kiln deployment outputs app --generation 4 --json" />
          <Cmd line="kiln deployment outputs app --show-secrets --json" />
        </div>
      </div>
      <div class="zones__iln">
        <Terms items={outputs} tone="slab" columns={2} />
      </div>
    </div>
  </Section>

  <Section id="s-ci" title="Deploy from a GitHub workflow.">
    <div class="zones">
      <div class="zones__k">
        <p class="lead">
          The action sends your Docker build context to Kiln, builds the image there and deploys it. It reads the API
          URL and token from repository secrets.
        </p>
        <p>
          It sets two outputs, <code>image_id</code> and <code>machine_id</code>. It refuses a remote API over plain
          HTTP unless you set <code>allow-insecure-http: true</code>.
        </p>
        <h3 class="sub recovery">Or run the same two steps by hand.</h3>
        <div class="stack-cmds">
          <Cmd line="kiln images build --name demo --tag latest --dockerfile-path ./Dockerfile --context-dir ." />
          <Cmd line="kiln deploy --name demo --image-id <image-id>" />
        </div>
      </div>
      <div class="zones__iln">
        <Block text={workflow} label="GitHub workflow step" />
      </div>
    </div>
  </Section>
</Base>

<style>
  .recovery {
    margin-top: 2.25rem;
  }
</style>
